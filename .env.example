# =============================================================================
# Cidade Viva Backend — Variáveis de ambiente locais (EXEMPLO COM PLACEHOLDERS)
# Copie este arquivo para `.env` na raiz do repositório e substitua os valores
# `CHANGE_ME_*` por segredos locais antes de executar `generate-secrets.ps1`
# e `docker compose`. NUNCA faça commit do arquivo `.env`.
# =============================================================================

# --- PostgreSQL local (bind exclusivo em 127.0.0.1) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cidade_viva
POSTGRES_USER=cv_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- Broker MQTT Mosquitto local (bind exclusivo em 127.0.0.1) ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Credenciais do serviço Backend (assinante telemetry/status/ack, publicador commands)
MQTT_BACKEND_USER=cv_backend
MQTT_BACKEND_PASSWORD=CHANGE_ME_MQTT_BACKEND_PASSWORD
MQTT_BACKEND_CLIENT_ID=cidade-viva-backend-local

# Credenciais do Simulador / Dispositivos de laboratório (publicador telemetry/status/ack, assinante commands)
MQTT_SIMULATOR_USER=cv_simulator
MQTT_SIMULATOR_PASSWORD=CHANGE_ME_MQTT_SIMULATOR_PASSWORD

# --- mapeamento para ASP.NET Core Configuration (Database__* e Mqtt__*) ---
Database__Host=127.0.0.1
Database__Port=5432
Database__Database=cidade_viva
Database__Username=cv_app
Database__Password=CHANGE_ME_POSTGRES_PASSWORD

Mqtt__Host=127.0.0.1
Mqtt__Port=1883
Mqtt__ClientId=cidade-viva-backend-local
Mqtt__Username=cv_backend
Mqtt__Password=CHANGE_ME_MQTT_BACKEND_PASSWORD

# Full local MVP; initialize DB explicitly before enabling these routes/workers.
City__Enabled=true
City__TelemetryStaleTtlSeconds=30
City__CommandTtlSeconds=10
City__AckTimeoutSeconds=15
Cors__Origins__0=http://localhost:4200
Cors__Origins__1=http://127.0.0.1:4200

# Only used during explicit initialization. No default passwords and no public registration.
Bootstrap__viewer__Username=viewer
Bootstrap__viewer__Password=CHANGE_ME_VIEWER_PASSWORD
Bootstrap__operator__Username=operator
Bootstrap__operator__Password=CHANGE_ME_OPERATOR_PASSWORD
